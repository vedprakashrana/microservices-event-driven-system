# Global & Shared Configuration
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-for-microservices-auth-2026
JWT_EXPIRES_IN=2h

# API Gateway Configuration
PORT=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CORS_ORIGIN=*

# Downstream Service URLs for API Gateway
USER_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8002

# NATS JetStream Broker Configuration
NATS_URL=nats://localhost:4222
NATS_TOKEN=microservices-secure-nats-token-2026

# Persistence Paths
USER_DB_PATH=./users.db
NOTIFICATION_DB_PATH=./notifications.db
